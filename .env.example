# Auth is off unless this is the explicit value true.
VITE_AUTH_ENABLED=

# Per-app Grok broker client. Injected on deploy. Required to turn sign-in on.
GROK_AUTH_CLIENT_ID=
GROK_AUTH_CLIENT_SECRET=

# Shared live-preview OAuth client secret. Used only when GROK_AUTH_CLIENT_SECRET
# is unset. Leave empty. Never commit a value.
GROK_PREVIEW_CLIENT_SECRET=

# Server-only Upstash Redis / Vercel KV. Read from process.env in server
# functions. Never prefix these with VITE_ and never import them into client
# code. Production (NODE_ENV=production or VERCEL=1) fails closed if they are
# missing or Redis is unreachable: geocoding returns 503 and OSRM is skipped.
# Local dev and tests may omit them and use in-memory limits.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
